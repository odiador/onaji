{
  "name": "onaji-vscode",
  "displayName": "Onaji Reactive Automation",
  "description": "Visual Studio Code interface for the Onaji Universal Reactive Engine",
  "version": "0.1.0",
  "publisher": "odiador",
  "repository": {
    "type": "git",
    "url": "https://github.com/odiador/onaji"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Programming Languages",
    "Build"
  ],
  "activationEvents": [
    "workspaceContains:onaji.yaml",
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Onaji",
      "properties": {
        "onaji.executablePath": {
          "type": "string",
          "default": "",
          "description": "Custom path to the onaji executable binary"
        },
        "onaji.autoStartDaemon": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start the Onaji Daemon when opening a workspace"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "onaji-container",
          "title": "Onaji",
          "icon": "$(sync~spin)"
        }
      ]
    },
    "views": {
      "onaji-container": [
        {
          "id": "onaji.tasksView",
          "name": "Pipeline Tasks",
          "icon": "$(tasklist)"
        },
        {
          "id": "onaji.resourcesView",
          "name": "Observed Resources",
          "icon": "$(file-code)"
        }
      ]
    },
    "commands": [
      {
        "command": "onaji.startDaemon",
        "title": "Onaji: Start Daemon",
        "category": "Onaji"
      },
      {
        "command": "onaji.restartDaemon",
        "title": "Onaji: Restart Daemon",
        "category": "Onaji",
        "icon": "$(refresh)"
      },
      {
        "command": "onaji.runPipeline",
        "title": "Onaji: Run Active Pipeline",
        "category": "Onaji",
        "icon": "$(play)"
      },
      {
        "command": "onaji.openVisualGraph",
        "title": "Onaji: Open Interactive Causal Graph",
        "category": "Onaji",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "onaji.showGraph",
        "title": "Onaji: Inspect Dependency Graph (JSON)",
        "category": "Onaji"
      },
      {
        "command": "onaji.openLogs",
        "title": "Onaji: Open Output Logs",
        "category": "Onaji"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "onaji.runPipeline",
          "when": "view == onaji.tasksView",
          "group": "navigation"
        },
        {
          "command": "onaji.openVisualGraph",
          "when": "view == onaji.tasksView",
          "group": "navigation"
        },
        {
          "command": "onaji.restartDaemon",
          "when": "view == onaji.tasksView",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^2.24.0",
    "typescript": "^5.9.3"
  }
}
