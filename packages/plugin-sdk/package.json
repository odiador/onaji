{
  "name": "@onaji/plugin-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for building Onaji Universal Automation Plugins",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "node --test dist/**/*.test.js"
  },
  "keywords": [
    "onaji",
    "plugin",
    "automation",
    "jsonrpc",
    "sdk"
  ],
  "author": "odiador",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  }
}
